# Caddy: recebe as conexões da internet, obtém e renova o certificado HTTPS
# sozinho (Let's Encrypt) e repassa para o painel, que só escuta em 127.0.0.1.
# Gerado por deploy/vps/instalar-vps.sh a partir deste modelo.
{
	email __EMAIL__
}

__DOMINIO__ {
	encode gzip

	# Mesmo limite do painel (TAMANHO_MAX_MB) para envio de vídeos.
	request_body {
		max_size 500MB
	}

	header {
		# O navegador passa a usar só HTTPS neste domínio.
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	reverse_proxy 127.0.0.1:5000

	log {
		output file /var/log/caddy/painel.log {
			roll_size 10MiB
			roll_keep 10
		}
	}
}
