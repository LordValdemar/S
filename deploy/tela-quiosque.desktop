# Abre a tela de exibição em tela cheia quando a sessão gráfica inicia.
# Copie para ~/.config/autostart/ no computador ligado à TV (ex.: Raspberry Pi).
# Troque http://localhost:5000/player (nas duas ocorrências) pelo endereço da tela,
# visto no painel em "Telas" (ex.: http://192.168.0.10:5000/tela/Ab3dE5fG7hJk).
[Desktop Entry]
Type=Application
Name=Painel de Propagandas - Exibição
Exec=sh -c "sleep 10; chromium --kiosk --noerrdialogs --disable-infobars --incognito --autoplay-policy=no-user-gesture-required http://localhost:5000/player || chromium-browser --kiosk --noerrdialogs --disable-infobars --incognito --autoplay-policy=no-user-gesture-required http://localhost:5000/player"
X-GNOME-Autostart-enabled=true
