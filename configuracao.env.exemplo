# Configuração do Painel de Propagandas.
# Copie este arquivo para "configuracao.env" (na mesma pasta), ajuste e reinicie o painel.
# Linhas começadas com # são ignoradas. Valores com espaços ou com "$" vão entre aspas simples.
# (Numa VPS instalada pelo deploy/vps/instalar-vps.sh, use /etc/painel-propagandas/ambiente.)

# --- Sua marca ---
NOME_PLATAFORMA='Painel de Propagandas'
CONTATO_PLATAFORMA=
FUSO_HORARIO=America/Sao_Paulo

# --- Rede ---
PORTA=5000
# Acesso pela internet com HTTPS (Cloudflare Tunnel, Caddy...): descomente as duas linhas.
# ATRAS_DE_PROXY=1
# COOKIE_SEGURO=1

# --- Alertas por e-mail (opcional; ex.: Gmail com "senha de app") ---
SMTP_HOST=
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=
ALERTA_EMAILS=
# Ou um webhook (Slack, Teams, Discord, Google Chat):
ALERTA_WEBHOOK=

# --- Cobrança automática pelo Asaas (opcional) ---
# Sem endereço público, o webhook não chega: as faturas são conferidas de hora em hora.
ASAAS_API_KEY=
ASAAS_AMBIENTE=sandbox
ASAAS_WEBHOOK_TOKEN=
COBRANCA_TOLERANCIA_DIAS=5

# --- Backups ---
BACKUP_MANTER=7
